# Keil target output generated by the unique main firmware project.
firmware/ADC/MDK-ARM/ADC/
firmware/ADC/MDK-ARM/*.log

# Keil target outputs under archived teammate snapshots and future integration
# projects.  Keep the project files, sources and linker scripts; omit
# reproducible target objects and command-line build logs.
teammate/**/ADC/MDK-ARM/ADC/
teammate/**/ADC/MDK-ARM/*.log
archive/**/ADC/MDK-ARM/ADC/
archive/**/ADC/MDK-ARM/*.log

# Matplotlib SVG exports are reproducible from the committed scripts and data.
tests/phase_coverage/*.svg
